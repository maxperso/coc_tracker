{
  "name": "coc-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file=.env server/main.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/main.ts server/cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist-server --packages=external",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "test": "vitest run",
    "sync-data": "node scripts/sync-clashking.mjs ClashKingAssets",
    "check-export": "vite-node scripts/check-export.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fontsource/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  }
}
