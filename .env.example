# Copie ce fichier en .env et remplis-le. Ne le commite jamais.

# Mot de passe Postgres (hexadécimal : pas besoin d'échapper dans l'URL). openssl rand -hex 24
POSTGRES_PASSWORD=
# Secret de signature des sessions et des codes email, 32 caractères au moins. openssl rand -hex 32
JWT_SECRET=
# Code à donner à tes potes pour créer un compte (6 caractères au moins).
# Vide : n'importe qui peut s'inscrire, avec un email confirmé.
INVITE_CODE=
# Adresse publique du site : les écritures venant d'ailleurs sont refusées.
APP_ORIGIN=https://coc.maxperso.fr
# Port et IP publiés sur l'hôte, vers lesquels Nginx Proxy Manager redirige.
APP_PORT=3000
APP_BIND=0.0.0.0

# SMTP (le même que celui de ton WordPress, réglages de WP Mail SMTP ou équivalent).
# Port 587 + SMTP_SECURE=false : STARTTLS. Port 465 + SMTP_SECURE=true : TLS direct.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur : une adresse autorisée par ton SMTP (même domaine que WordPress de préférence).
MAIL_FROM="COC Tracker <no-reply@maxperso.fr>"

# Dev uniquement (npm run dev:server). Sans SMTP_HOST, les codes s'affichent dans la console.
# DATABASE_URL=postgres://coc:MOT_DE_PASSE@127.0.0.1:5432/coc
# APP_ORIGIN=http://localhost:5173
